{
  "name": "vits-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:mobile": "node tools/run-ng.mjs serve mobile --port 4200",
    "dev:admin": "node tools/run-ng.mjs serve admin --port 4300",
    "dev:api": "node node_modules/tsx/dist/cli.mjs watch --tsconfig apps/api/tsconfig.app.json apps/api/src/main.ts",
    "build:mobile": "node tools/run-ng.mjs build mobile",
    "build:admin": "node tools/run-ng.mjs build admin",
    "build:api": "node tools/build-api.mjs",
    "cap:sync": "node tools/run-cap.mjs sync android",
    "cap:open:android": "node tools/run-cap.mjs open android",
    "test:crypto-api": "node node_modules/vitest/vitest.mjs run --config vitest.api.config.mts",
    "test": "node node_modules/vitest/vitest.mjs run --config vitest.api.config.mts && node tools/run-ng.mjs test mobile --watch=false && node tools/run-ng.mjs test admin --watch=false",
    "lint": "node node_modules/eslint/bin/eslint.js . && node tools/check-style-tokens.mjs",
    "typecheck": "node node_modules/@angular/compiler-cli/bundles/src/bin/ngc.js -p apps/mobile/tsconfig.app.json --noEmit && node node_modules/typescript/bin/tsc -p apps/mobile/tsconfig.spec.json --noEmit && node node_modules/@angular/compiler-cli/bundles/src/bin/ngc.js -p apps/admin/tsconfig.app.json --noEmit && node node_modules/typescript/bin/tsc -p apps/admin/tsconfig.spec.json --noEmit && node node_modules/typescript/bin/tsc -p apps/api/tsconfig.app.json --noEmit && node node_modules/typescript/bin/tsc -p apps/api/tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@ionic/angular": "^9.0.0",
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.2",
    "@nestjs/swagger": "^12.1.2",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@supabase/supabase-js": "^2.119.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ionicons": "^8.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.25.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.25.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.0"
  }
}
