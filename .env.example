# VITS Environment Configuration Template (never commit real .env!)

# Server (apps/api)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200,http://localhost:8100
LIBRARY_TIMEZONE=Asia/Manila

# JWT & Session Security (replace with 32+ char random secrets in production)
JWT_ACCESS_SECRET=vits-dev-access-secret-change-in-production-32chars
JWT_REFRESH_SECRET=vits-dev-refresh-secret-change-in-production-32chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=14

# Phase 9+: Supabase Connection
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY (anon/publishable) are safe to mirror into apps/mobile/src/environments/
# NEVER expose SUPABASE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, or DATABASE_URL to mobile or admin clients.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_your_supabase_publishable_key
SUPABASE_SECRET_KEY=replace_in_local_env
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Ed25519 Server Trust Signing Key (optional in dev; auto-generated ephemeral keypair if unset)
TRUST_KEY_KID=vits-ed25519-dev-1
TRUST_PRIVATE_KEY_B64=
TRUST_PUBLIC_KEY_B64=

# Dual-Supabase Database Failover (Phase 9+)
DATABASE_URL_PRIMARY=
DATABASE_URL_BACKUP=
ACTIVE_DB=primary
