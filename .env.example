# VITS Environment Configuration Example (No Secrets Committed)
# Frontend settings live in apps/{mobile,admin}/src/environments/ (zero secrets).
# Backend settings below will be consumed by apps/api starting in Phase 3.

NODE_ENV=development
PORT=3000
LIBRARY_TIMEZONE=Asia/Manila

# Phase 3+: Identity & Ed25519 QR Signing (replace locally; never commit real keys)
JWT_ACCESS_SECRET=replace_with_32_byte_random_secret_in_local_env
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=1209600
TRUST_ACTIVE_KID=vits-ed25519-dev-1
TRUST_ED25519_PRIVATE_KEY_B64URL=replace_in_local_env

# Phase 9+: Supabase Server-Side Connection (never expose to mobile or admin clients)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace_in_local_env
